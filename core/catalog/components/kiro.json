{
  "schemaVersion": 1,
  "id": "kiro",
  "displayName": "Kiro",
  "kind": "external",
  "launchers": [
    {
      "id": "kiro",
      "displayName": "Kiro",
      "type": "application",
      "workspaceMode": "environment",
      "executable": "{{external.executable}}",
      "arguments": [
        "--new-window",
        "{{workspace.selected}}"
      ],
      "startMode": "detached"
    }
  ],
  "capability": {
    "id": "application.kiro",
    "exclusive": false
  },
  "tracks": [
    {
      "id": "local",
      "displayName": "Instalación local"
    }
  ],
  "defaultProvider": "external",
  "defaultTrack": "local",
  "updatePolicy": "manual",
  "providers": [
    {
      "id": "external",
      "componentId": "kiro-external",
      "displayName": "Instalación externa",
      "vendor": "Amazon Web Services",
      "license": "Proprietary",
      "homepage": "https://kiro.dev/",
      "resolver": {
        "type": "external-executable"
      },
      "verification": {
        "type": "local-executable"
      }
    }
  ],
  "install": {
    "type": "external-executable",
    "executableNames": [
      "kiro.exe"
    ],
    "prompt": "Ruta completa al ejecutable kiro.exe"
  },
  "data": {
    "directories": [],
    "files": []
  },
  "environment": {
    "variables": {},
    "path": []
  }
}
